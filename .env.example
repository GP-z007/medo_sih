# Copy to .env; keep credentials out of source control.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://udaan:YOUR_LOCAL_PASSWORD@host.docker.internal:5432/udaan
API_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
API_TOKEN=
DISPLAY=:99
BROWSER_VIEW_URL=http://127.0.0.1:6080/vnc.html
OPERATOR_WAIT_SECONDS=900
COLLECTION_CONCURRENCY=5
WORKER_LEASE_SECONDS=30
DEFAULT_RESILIENCE_PROFILE=Standard
EXPORT_DIRECTORY=var/exports
RECIPE_DIRECTORY=recipes
# OpenAI-compatible provider. Add your own endpoint, model and secret locally.
AI_PROVIDER=openai_compatible
AI_PROVIDER_NAME=NVIDIA
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_API_KEY=
AI_TIMEOUT_SECONDS=90
HEALTH_INTERVAL_SECONDS=60
WEAVIATE_URL=http://host.docker.internal:8080
WEAVIATE_API_KEY=
SANDBOX_IMAGE=udaan-repair:local

# Bounded one-action planning; health still uses AI_TIMEOUT_SECONDS.
AI_RECIPE_TIMEOUT_SECONDS=180

# Optional installed Global IP Dataset JSON. Only configured profiles are exposed.
GLOBAL_IP_DATASET_PATH=
